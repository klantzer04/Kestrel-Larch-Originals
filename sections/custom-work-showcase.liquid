{% assign photos = 0 %}
{% for block in section.blocks %}{% if block.settings.image != blank %}{% assign photos = photos | plus: 1 %}{% endif %}{% endfor %}
{% if photos > 0 or request.design_mode %}
<section class="section container work-showcase">
  <div class="section-heading"><div><p class="eyebrow">ORIGINAL DETAILS. EVERYDAY CONNECTIONS.</p><h2>{{ section.settings.heading | escape }}</h2></div><p class="showcase-intro">{{ section.settings.intro | escape }}</p></div>
  <div class="showcase-grid">
  {% for block in section.blocks %}
    {% if block.settings.image != blank or request.design_mode %}
    <article class="showcase-piece" {{ block.shopify_attributes }}>
      <div class="showcase-photo">
        {% if block.settings.image != blank %}
          {% assign photo_alt = block.settings.alt | default: block.settings.image.alt | default: block.settings.title %}
          {{ block.settings.image | image_url: width: 1800 | image_tag: widths: '450, 750, 1100, 1500, 1800', sizes: '(min-width: 900px) 46vw, 100vw', loading: 'lazy', alt: photo_alt }}
        {% else %}{% render 'placeholder', label: block.settings.title %}{% endif %}
      </div>
      <div class="showcase-caption"><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.description | escape }}</p>
      {% if block.settings.product != blank %}<a class="text-link" href="{{ block.settings.product.url }}">Explore this piece ↗</a>{% else %}<a class="text-link" href="/pages/custom-order">Discuss a custom piece ↗</a>{% endif %}</div>
    </article>
    {% endif %}
  {% endfor %}
  </div>
</section>
{% endif %}
{% schema %}
{
  "name": "Custom work showcase",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Personal by design."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "From a favorite game to a meaningful gift, explore the possibilities of custom woodwork."
    }
  ],
  "blocks": [
    {
      "type": "piece",
      "name": "Featured piece",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Original product photo"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Link to a Shopify product (optional)"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Photo description for accessibility"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Custom work showcase"
    }
  ]
}
{% endschema %}
