<section class="section container studio-custom-gallery">
 <div class="studio-section-header">
  <div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div>
  {% if section.settings.intro != blank %}<p>{{ section.settings.intro | escape }}</p>{% endif %}
 </div>
 <div class="studio-inspiration-grid">
  {% for block in section.blocks %}
   <article class="studio-inspiration-piece" {{ block.shopify_attributes }}>
    <div class="studio-inspiration-image">
     {% if block.settings.image != blank %}
      {% assign gallery_alt = block.settings.image.alt | default: block.settings.title %}
      {{ block.settings.image | image_url: width: 1100 | image_tag: widths: '320, 480, 720, 900, 1100', sizes: '(min-width: 1100px) 26vw, (min-width: 600px) 46vw, 95vw', loading: 'lazy', alt: gallery_alt }}
     {% else %}{% render 'placeholder', label: block.settings.title %}{% endif %}
    </div>
    <h3>{{ block.settings.title | escape }}</h3>
    {% if block.settings.caption != blank %}<p>{{ block.settings.caption | escape }}</p>{% endif %}
   </article>
  {% endfor %}
 </div>
</section>
{% schema %}
{
 "name":"Custom order inspiration",
 "settings":[
  {"type":"text","id":"eyebrow","label":"Eyebrow","default":"PERSONAL BY DESIGN"},
  {"type":"text","id":"heading","label":"Headline","default":"A few ways to make it yours."},
  {"type":"textarea","id":"intro","label":"Introduction","default":"A starting point for the piece you have in mind."}
 ],
 "blocks":[{"type":"idea","name":"Inspiration photo","settings":[
   {"type":"image_picker","id":"image","label":"Approved photo"},
   {"type":"text","id":"title","label":"Heading"},
   {"type":"textarea","id":"caption","label":"Description"}
 ]}],
 "max_blocks":8,
 "presets":[{"name":"Custom order inspiration"}]
}
{% endschema %}
