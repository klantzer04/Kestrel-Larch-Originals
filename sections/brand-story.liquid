<section class="story-band"><div class="container story-grid"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><div><div class="richtext">{{ section.settings.text }}</div><a class="text-link" href="{{ section.settings.link | default: '/pages/about' }}">{{ section.settings.label | escape }} ↗</a></div></div></section>
{% schema %}
{
  "name": "Craft story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A LITTLE GRAIN. A LOT OF CHARACTER."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Never quite the same. Always an original."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Wood brings its own story to every piece. Our approach is simple: thoughtful design, considered details, and room for the natural character to shine.</p>"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Link label",
      "default": "Meet Kestrel Larch"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Craft story"
    }
  ]
}
{% endschema %}
