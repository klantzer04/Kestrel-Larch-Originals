<section class="section container"><div class="section-heading"><div><p class="eyebrow">FIND YOUR EVERYDAY ORIGINAL</p><h2>{{ section.settings.heading | escape }}</h2></div><a class="text-link" href="{{ routes.all_products_collection_url }}">Shop all pieces ↗</a></div><div class="category-grid">{% for block in section.blocks %}<a class="category-card" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}><div class="category-image">{% if block.settings.image %}{{ block.settings.image | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '(min-width: 900px) 23vw, 80vw', loading: 'lazy' }}{% else %}{% render 'placeholder', label: block.settings.title %}{% endif %}</div><h3>{{ block.settings.title | escape }} <span aria-hidden="true">↗</span></h3><p>{{ block.settings.caption | escape }}</p></a>{% endfor %}</div></section>
{% schema %}
{
  "name": "Shop by category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for the way you gather."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photography"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Collection or page link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Shop by category"
    }
  ]
}
{% endschema %}
