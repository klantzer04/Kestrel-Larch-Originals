<section class="studio-process-band">
 <div class="section container studio-process">
  <div class="studio-process-header">
   <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
   <h2>{{ section.settings.heading | escape }}</h2>
   <p>{{ section.settings.intro | escape }}</p>
  </div>
  <div class="studio-steps">
   {% for block in section.blocks %}
    <div class="studio-step" {{ block.shopify_attributes }}>
     <span class="studio-step-number" aria-hidden="true">0{{ forloop.index }}</span>
     <h3>{{ block.settings.title | escape }}</h3>
     <p>{{ block.settings.text | escape }}</p>
    </div>
   {% endfor %}
  </div>
 </div>
</section>
{% schema %}
{
 "name":"How custom ordering works",
 "settings":[
  {"type":"text","id":"eyebrow","label":"Eyebrow","default":"YOUR PROJECT JOURNEY"},
  {"type":"text","id":"heading","label":"Headline","default":"From idea to original."},
  {"type":"textarea","id":"intro","label":"Introduction","default":"No pressure to have every detail decided. Start with what matters to you."}
 ],
 "blocks":[{"type":"step","name":"Process step","settings":[
  {"type":"text","id":"title","label":"Heading"},
  {"type":"textarea","id":"text","label":"Description"}
 ]}],
 "max_blocks":4,
 "presets":[{"name":"How custom ordering works"}]
}
{% endschema %}
