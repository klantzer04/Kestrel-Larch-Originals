<section class="section container custom-callout"><p class="eyebrow">SOMETHING ONLY YOU COULD IMAGINE</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p><a class="button" href="/pages/custom-order">Let’s talk about your idea ↗</a></section>
{% schema %}
{
  "name": "Custom order invitation",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your idea. Our craft."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A personal gift. A piece for your space. Something entirely your own. Start a conversation about a custom project."
    }
  ],
  "presets": [
    {
      "name": "Custom order invitation"
    }
  ]
}
{% endschema %}
