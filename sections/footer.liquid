<footer class="site-footer"><div class="container footer-grid"><div>{% assign footer_logo = section.settings.logo | default: settings.brand_stacked %}
{% if footer_logo != blank %}<a class="footer-brand" href="{{ routes.root_url }}">{{ footer_logo | image_url: width: 600 | image_tag: widths: '200, 400, 600', sizes: '200px', loading: 'lazy', alt: shop.name }}</a>{% else %}<p class="eyebrow">KESTREL LARCH ORIGINALS</p>{% endif %}<h2>Made with care.<br>Kept for years.</h2><p>Handcrafted woodwork for everyday rituals.</p></div><nav aria-label="Footer navigation">{% if section.settings.menu != blank %}{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}{% else %}<a href="/pages/contact">Contact</a><a href="/pages/faq">FAQ & care</a><a href="/pages/custom-order">Request a custom piece</a>{% endif %}{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</nav></div><div class="container footer-bottom">© {{ 'now' | date: '%Y' }} {{ shop.name | escape }} · Thoughtfully crafted.</div></footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    {"type":"image_picker","id":"logo","label":"Approved footer logo override"},
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu"
    }
  ]
}
{% endschema %}
