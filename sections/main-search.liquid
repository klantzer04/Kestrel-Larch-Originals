<section class="section container"><h1>Search</h1><form action="{{ routes.search_url }}" method="get"><label for="Search">Find a piece</label><input id="Search" type="search" name="q" value="{{ search.terms | escape }}"><button class="button">Search</button></form>{% if search.performed %}{% paginate search.results by 24 %}<p>{{ search.results_count }} results</p>{% for result in search.results %}<p><a href="{{ result.url }}">{{ result.title | escape }}</a></p>{% endfor %}{{ paginate | default_pagination }}{% endpaginate %}{% endif %}</section>
{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
