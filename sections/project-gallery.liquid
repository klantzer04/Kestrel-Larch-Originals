<section class="section container"><p class="eyebrow">THE WORK, UP CLOSE</p><h1>{{ page.title | default: 'Completed projects' | escape }}</h1><div class="richtext">{{ page.content }}</div><div class="product-grid">{% for block in section.blocks %}<figure {{ block.shopify_attributes }}>{% if block.settings.image %}{{ block.settings.image | image_url: width: 1200 | image_tag: widths: '400, 800, 1200', loading: 'lazy' }}{% else %}{% render 'placeholder', label: 'Project photography placeholder' %}{% endif %}<figcaption><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.description | escape }}</p></figcaption></figure>{% else %}{% for i in (1..3) %}{% render 'placeholder', label: 'Completed project — add your own photography' %}{% endfor %}{% endfor %}</div></section>
{% schema %}
{
  "name": "Project gallery",
  "settings": [],
  "blocks": [
    {
      "type": "project",
      "name": "Project",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Project photography"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Project gallery"
    }
  ]
}
{% endschema %}
