<section class="hero container"><div class="hero-copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><p class="lede">{{ section.settings.text | escape }}</p><div class="actions"><a class="button" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button | escape }} <span aria-hidden="true">↗</span></a><a class="text-link" href="/pages/custom-order">Make it your own →</a></div><p class="hero-note">Small details. Lasting character.</p></div><div class="hero-image">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1800 | image_tag: widths: '600, 1000, 1400, 1800', sizes: '(min-width: 900px) 55vw, 100vw', loading: 'eager', fetchpriority: 'high' }}{% else %}{% render 'placeholder', label: 'Your handcrafted work, beautifully photographed' %}{% endif %}<span class="image-caption">01 / THE EVERYDAY, CONSIDERED</span></div></section>
{% schema %}
{
  "name": "Editorial hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NATURAL MATERIALS. ORIGINAL CHARACTER."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Good wood.\nGreat company."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Thoughtful pieces for the table, the game, and the moments in between. Crafted in wood. Made to become part of your story."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero photography"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button text",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Editorial hero"
    }
  ]
}
{% endschema %}
