<div class="featured-band">
  <section class="section container signature-showcase">
    <div class="signature-showcase-layout">
      <div class="signature-showcase-media">
        {% if section.settings.image != blank %}
          {% assign signature_image_alt = section.settings.image.alt | default: 'Selection of handcrafted pieces from Kestrel Larch Originals' %}
          {{ section.settings.image | image_url: width: 2000 | image_tag: widths: '440, 750, 1000, 1400, 1800, 2000', sizes: '(min-width: 900px) 52vw, 100vw', loading: 'lazy', alt: signature_image_alt }}
        {% else %}
          {% render 'placeholder', label: 'Approved collection photography' %}
        {% endif %}
      </div>
      <div class="signature-showcase-copy">
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        <h2>{{ section.settings.heading | escape }}</h2>
        {% if section.settings.description != blank %}
          <p class="signature-showcase-description">{{ section.settings.description | escape }}</p>
        {% endif %}
        {% if section.settings.button_label != blank %}
          <a class="signature-showcase-link" href="{{ section.settings.link | default: '#featured-work' }}">
            {{ section.settings.button_label | escape }}
            <span aria-hidden="true">↗</span>
          </a>
        {% endif %}
      </div>
    </div>
    {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
      <div class="signature-product-selection">
        <h3>{{ section.settings.collection_heading | escape }}</h3>
        <div class="product-grid">
          {% for product in section.settings.collection.products limit: section.settings.limit %}
            {% render 'product-card', product: product %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </section>
</div>
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Small heading","default":"THE KESTREL COLLECTION"},
    {"type":"text","id":"heading","label":"Headline","default":"Crafted to leave an impression."},
    {"type":"textarea","id":"description","label":"Description","default":"Distinctive woodwork, thoughtful details, and pieces made to be enjoyed for years."},
    {"type":"image_picker","id":"image","label":"Approved collection photo"},
    {"type":"text","id":"button_label","label":"Link text","default":"Explore our work"},
    {"type":"url","id":"link","label":"Optional link override"},
    {"type":"collection","id":"collection","label":"Optional shoppable collection"},
    {"type":"text","id":"collection_heading","label":"Products heading","default":"Explore the collection"},
    {"type":"range","id":"limit","label":"Products","min":2,"max":8,"step":1,"default":3}
  ],
  "presets":[{"name":"Featured collection"}]
}
{% endschema %}
