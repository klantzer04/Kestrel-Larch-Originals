<div class="featured-band">
<section class="section container">
  <div class="section-heading"><div><p class="eyebrow">CRAFTED TO BE USED, LOVED & SHARED</p><h2>{{ section.settings.heading | escape }}</h2></div></div>
  {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
    <div class="product-grid">
      {% for product in section.settings.collection.products limit: section.settings.limit %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>
  {% elsif section.settings.image != blank %}
    <div class="featured-photo">
      {{ section.settings.image | image_url: width: 2000 | image_tag: widths: '600, 1000, 1400, 1800, 2000', sizes: '(min-width: 900px) 85vw, 100vw', loading: 'lazy', alt: 'Selection of Kestrel Larch Originals handcrafted woodwork' }}
      <a class="text-link" href="/pages/custom-order">Discuss a custom piece ↗</a>
    </div>
  {% else %}
    <div class="product-grid">{% assign samples = 'Walnut cribbage board,Everyday cutting board,Cheese slicer' | split: ',' %}{% for title in samples %}<article class="product-card">{% render 'placeholder', label: title %}<h3>{{ title }}</h3><p class="muted">Sample product · Add your catalog in Shopify</p></article>{% endfor %}</div>
  {% endif %}
</section>
</div>
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"A few future favorites."},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"image_picker","id":"image","label":"Approved collection photography when no products are selected"},
    {"type":"range","id":"limit","label":"Products","min":2,"max":8,"step":1,"default":3}
  ],
  "presets":[{"name":"Featured collection"}]
}
{% endschema %}
