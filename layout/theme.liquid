<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="canonical" href="{{ canonical_url }}">
<title>{{ page_title | escape }}{% unless page_title contains shop.name %} — {{ shop.name | escape }}{% endunless %}</title>
{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
{{ content_for_header }}
{% style %}:root{--cream:{{ settings.color_background }};--charcoal:{{ settings.color_text }};--slate:{{ settings.color_accent }};--copper:{{ settings.color_copper }};--tan:{{ settings.color_tan }};--width:{{ settings.page_width }}px}{% endstyle %}
{{ 'theme.css' | asset_url | stylesheet_tag }}
<script src="{{ 'theme.js' | asset_url }}" defer></script>
</head>
<body class="design-{{ settings.design_direction | default: 'charcoal-copper' }}"><a class="skip-link" href="#MainContent">Skip to content</a>
{% sections 'header-group' %}
<main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
{% sections 'footer-group' %}
</body></html>
